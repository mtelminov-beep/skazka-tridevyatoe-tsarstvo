# Единый перевод строки в репозитории.
* text=auto eol=lf

CHANGELOG.md merge=union

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif  binary
*.mp4  binary
*.webm binary
*.mp3  binary
*.ogg  binary
*.m4a  binary

# Журнал версий пишется параллельно с разных машин. Обе записи только
# дописываются в конец, поэтому union-слияние честно сохраняет и свою,
# и чужую версию вместо конфликта посреди rebase внутри bump.
.versions/log.jsonl merge=union
