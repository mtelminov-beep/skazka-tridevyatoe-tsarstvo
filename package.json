{
  "name": "skazka-interactive",
  "version": "1.16.2",
  "private": true,
  "description": "Интерактивная панель «Тридевятое царство» — русские народные сказки для детской библиотеки нового поколения",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "kiosk": "npm run build && npm run start",
    "check": "npm --prefix frontend run check",
    "desktop:web": "set \"VITE_DESKTOP=true\" && npm --prefix frontend run build -- --outDir dist-desktop",
    "desktop:installer": "npm run desktop:web && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ru.tridevyatoe.skazki",
    "productName": "Тридевятое царство",
    "directories": { "output": "release/windows" },
    "files": ["electron/**/*", "backend/src/**/*", "backend/data/**/*", "backend/node_modules/**/*", "frontend/dist-desktop/**/*", "media/uploads/**/*", "package.json"],
    "asar": false,
    "compression": "store",
    "win": { "target": ["nsis"], "artifactName": "Tridevyatoe-Tsarstvo-Setup-${version}.${ext}" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Тридевятое царство",
      "perMachine": false
    }
  }
}
