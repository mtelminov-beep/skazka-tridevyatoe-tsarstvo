{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/version.mjs hook session-start",
            "timeout": 90,
            "statusMessage": "Синхронизирую журнал версий с GitHub…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/version.mjs hook stop",
            "timeout": 30,
            "statusMessage": "Проверяю, уехала ли работа на GitHub…"
          }
        ]
      }
    ]
  }
}
