node_modules/
dist/
*.log
*.tsbuildinfo

# Блокировка журнала версий — временный файл конкретного процесса.
# Без этой строки `bump` коммитит собственный lock и оставляет рабочее
# дерево грязным сразу после того, как записал версию.
.versions/.lock

# Состояние CMS и загруженные библиотекой файлы — это данные конкретной панели,
# а не код проекта. Восстанавливаются из резервной копии в админке.
backend/data/cms-state.json
media/uploads/*
!media/uploads/.gitkeep
